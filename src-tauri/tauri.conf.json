{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touhou Music Player",
  "version": "1.0.0",
  "identifier": "com.reimuhakurei.touhoumusicplayer",
  "build": {
    "frontendDist": "https://touhou-music-player.pages.dev/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Touhou Music Player",
        "url": "https://touhou-music-player.pages.dev/",
        "width": 1240,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Listen to Touhou music",
    "longDescription": "Browse and listen to Touhou music with playlists, comments, likes, and downloads.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "../TH Reimu NOBG.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
